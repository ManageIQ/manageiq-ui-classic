namespace :update do
  task :yarn do
    asset_engines.each do |engine|
      Dir.chdir engine.path do
        if ENV['TEST_SUITE'] == 'spec'
          warn "Skipping yarn install for #{engine.name} on travis #{ENV['TEST_SUITE']}"
          next
        end
        puts "== #{engine.name} =="
        system("which yarn >/dev/null") || abort("\n== You have to install yarn ==")
        system("yarn") || abort("\n== yarn failed in #{engine.path} ==") # Add --immutable once s390x doesn't change the checksums.
      end
    end
  end

  task :clean do
    # clean up old webpack packs to prevent stale packs now that we're hashing the filenames
    FileUtils.rm_rf(Rails.root.join('public', 'packs'))
  end

  task :print_engines do
    puts
    puts "JS plugins:"
    asset_engines.each do |engine|
      puts "  #{engine.name}:"
      puts "    namespace: #{engine.namespace}"
      puts "    path: #{engine.path}"
    end
    puts
  end

  task :ui => ['update:clean', 'update:yarn', 'locale:compile', 'webpack:compile', 'update:print_engines']
end

namespace :locale do
  desc "Compile gettext PO files into JS locale assets"
  task :compile do
    if %w[spec spec:jest].include?(ENV['TEST_SUITE'])
      warn "Skipping locale:compile"
      next
    end

    require Rails.root.join("lib/tasks/evm_rake_helper")
    EvmRakeHelper.with_dummy_database_url_configuration do
      Rake::Task[Rake::Task.task_defined?("app:environment") ? "app:environment" : "environment"].invoke
      require Rails.root.join("lib/vmdb/gettext/domains")
      require "gettext/po_parser"
      require "json"
      require "tempfile"

      po_files = {}
      Vmdb::Gettext::Domains.po_paths.each do |path|
        files = Pathname.glob(File.join(path, "**", "*.po")).sort
        files.each do |file|
          locale = file.dirname.basename.to_s
          next if locale == "en"

          po_files[locale] ||= []
          po_files[locale].push(file)
        end
      end

      target_dir = ManageIQ::UI::Classic::Engine.root.join("app/assets/locale")
      FileUtils.mkdir_p(target_dir)

      po_files.each do |locale, files|
        out_file = target_dir.join("#{locale}.js")
        next if out_file.exist? && files.all? { |f| out_file.mtime >= f.mtime }

        Tempfile.create(["merged", ".po"]) do |temp_po|
          if files.size > 1
            system("rmsgcat", "--sort-by-msgid", "-o", temp_po.path, *files.map(&:to_s), :exception => true)
            po_content = File.read(temp_po.path)
          else
            po_content = File.read(files.first)
          end

          jed = po_to_jed(po_content, locale)
          content = "window.locales = window.locales || {};\nwindow.locales[#{locale.to_json}] = #{jed.to_json};\n"
          File.write(out_file, content)
        end
      end
    end
  end
end

namespace :webpack do
  def run_webpack(task)
    if %w(spec spec:jest).include? ENV['TEST_SUITE']
      warn "Skipping webpack:#{task} on travis #{ENV['TEST_SUITE']}"
      return
    end

    # Run the `webpack:compile` tasks without a fully loaded environment,
    # since when doing an appliance/docker build, a database isn't
    # available for the :environment task (prerequisite for
    # 'webpacker:compile') to function.
    EvmRakeHelper.with_dummy_database_url_configuration do
      Dir.chdir ManageIQ::UI::Classic::Engine.root do
        Rake::Task["webpack:paths"].invoke
        Rake::Task["webpacker:#{task}"].invoke
      end
    end
  end

  task :compile do
    run_webpack(:compile)
  end

  task :clobber do
    run_webpack(:clobber)
  end

  task :paths do
    json = JSON.pretty_generate(
      :info    => "This file is autogenerated by rake webpack:paths, do not edit",
      :output  => Rails.root.to_s,
      :engines => asset_engines.map { |p|
                    key = p.namespace
                    value = {:root => p.path,
                             :node_modules => File.join(p.path, 'node_modules')}

                    [key, value]
                  }.to_h
    ) << "\n"

    File.write(ManageIQ::UI::Classic::Engine.root.join('config/webpack/paths.json'), json)
  end
end

# compile and clobber when running assets:* tasks
if Rake::Task.task_defined?("assets:precompile")
  # locale:compile must run before the sprockets compile so the generated
  # locale assets are included in the manifest
  Rake::Task["assets:precompile"].enhance(["locale:compile"]) do
    Rake::Task["webpack:compile"].invoke unless ENV["CI"]
  end

  Rake::Task["assets:precompile"].actions.each do |action|
    if action.source_location[0].include?(File.join("lib", "tasks", "webpacker"))
      Rake::Task["assets:precompile"].actions.delete(action)
    end
  end
end

if Rake::Task.task_defined?("assets:clobber")
  Rake::Task["assets:clobber"].enhance do
    Rake::Task["webpack:clobber"].invoke unless ENV["CI"]
  end

  Rake::Task["assets:clobber"].actions.each do |action|
    if action.source_location[0].include?(File.join("lib", "tasks", "webpacker"))
      Rake::Task["assets:clobber"].actions.delete(action)
    end
  end
end

namespace :yarn do
  # yarn:install is a rails 5.1 task, webpacker:compile needs it
  task :install do
    puts 'yarn:install called, not doing anything'
  end

  # useful right after upgrading node
  task :clobber do
    puts 'Removing yarn.lock and node_modules in...'
    asset_engines.each do |engine|
      puts "  #{engine.name} (#{engine.path})"
      FileUtils.rm_rf(engine.path.join('node_modules'))
      FileUtils.rm_rf(engine.path.join('yarn.lock'))
    end
  end
end

