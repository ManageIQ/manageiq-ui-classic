= render :partial => "layouts/flash_msg"
- case @display
- when "devices", "os_info", "hv_info", "networks", "resources_info"
  = react('VmConfig', {:sections => vm_config_data(@display)})
- when "snapshot_info"
  = render :partial => "vm_common/snapshots_desc"
- when "vmtree_info"
  = render :partial => "vm_common/vmtree"
