#class_props_div
  - show_props = x_node.split('-')[0] == "aec" || params[:pressed]
  - show_props ||= x_node.split('-')[0] == "aen" && params[:button] == "reset"
  - if show_props
    - if !@in_a_form_props
      = class_properties_data(@sb[:namespace_path], @ae_class)
      = render :partial => "domain_overrides", :locals  => {:node_prefix => "aec", :model => "Class"}
    - else
      #form_div
        %div{:style => "padding-top: 10px;"}
        = render :partial => "class_form"
