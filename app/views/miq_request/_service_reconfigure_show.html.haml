#main_div
  - s = @miq_request.source
  - st = s.service_template
  - ra = st.resource_actions.find_by_action('Reconfigure') if st
  - if ra && ra.dialog
    %fieldset
      %h3
        = _("Dialog Options")
      = react('Service',
              :initialData => service_request_data(@miq_request.options),
              :serviceType => "serviceRequest")
