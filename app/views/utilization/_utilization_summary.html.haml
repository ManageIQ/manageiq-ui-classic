#utilization_summary_div
  = render :partial => "layouts/flash_msg"
  - if @sb[:trend_rpt] && @sb[:summary]
    = render :partial => "utilization_options", :locals  => {:cap_type => "summ"}
    = render(:partial => "layouts/perf_charts",
      :locals         => {:charts => @sb[:ts_charts],
        :chart_set                => "utilts",
        :chart_data               => @sb[:chart_data]["utilts"],
        :perf_options             => @sb[:options]})
    %br{:clear => "all"}
  = react 'UtilizationSummary',
    :hasTrendData   => (@sb[:trend_rpt] && @sb[:summary]).present?,
    :noNodeSelected => x_node == "",
    :summary        => @sb[:summary].to_json,
    :model          => @sb[:options][:model],
    :trendStart     => format_timezone(@sb[:options][:trend_start], @sb[:options][:tz], "date"),
    :trendEnd       => format_timezone(@sb[:options][:trend_end], @sb[:options][:tz], "date"),
    :timezone       => @sb[:options][:time_profile_tz] || @sb[:options][:tz]
